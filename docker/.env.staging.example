# ─────────────────────────────────────────────────────────────
# Mettle Lift — STAGING host configuration.
# Copy to `.env` on the staging host and fill in real values.
#   cp .env.staging.example .env
# Variables marked REQUIRED must be set — docker compose will fail
# fast with a clear error if any are missing.
# ─────────────────────────────────────────────────────────────

# Written by remote-deploy.sh after migration succeeds — do not set manually.
IMAGE_TAG=

# REQUIRED — session signing secret. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Host ports ────────────────────────────────────────────────
# Published host ports; accept an optional bind address prefix.
# On Synology, bind to the LAN interface IP — published ports otherwise
# see every client as 172.18.0.1 (docker source NAT).
APP_PORT=192.168.1.24:3100
POWERSYNC_PORT=192.168.1.24:8581
MINIO_CONSOLE_PORT=192.168.1.24:9101

# ── Database (REQUIRED) ───────────────────────────────────────
POSTGRES_USER=mettlelift
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mettlelift

# ── MinIO — S3-compatible object storage (REQUIRED) ───────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# ── PowerSync (offline mobile/web sync) ───────────────────────
POWERSYNC_PRIVATE_KEY=
POWERSYNC_PUBLIC_KEY=

# ── Staging seed user ─────────────────────────────────────────
# Password for the seeded staging user account (seed-dev.ts).
SEED_USER_PASSWORD=

# ── Optional: AI workout generation ───────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Optional: OAuth sign-in providers ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# ── Optional: transactional email ─────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Mettle Lift <noreply@mettlelift.app>

# ── Optional: Stripe ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COACH_MONTHLY=
STRIPE_PRICE_COACH_YEARLY=

# ── Optional: meal photo scanning ─────────────────────────────
MEAL_SCAN_API_KEY=

# ── Optional: fitness device integrations ─────────────────────
DEVICE_TOKEN_ENCRYPTION_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
