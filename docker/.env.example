# ─────────────────────────────────────────────────────────────
# Zor self-hosting configuration. Copy to `.env` and edit.
#   cp .env.example .env
# Variables marked REQUIRED must be set — docker compose will fail
# fast with a clear error if any are missing.
# ─────────────────────────────────────────────────────────────

# REQUIRED — session signing secret. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# REQUIRED for any non-localhost deployment — the public URL users hit.
# Must match the address in the browser (and your reverse proxy), or
# logins will fail. Example: https://fitness.example.com
NEXTAUTH_URL=http://localhost:3000

# ── Database (REQUIRED) ───────────────────────────────────────
# Used by: postgres service, app DATABASE_URL, powersync
# PS_DATA_SOURCE_URI, and nightly backup service.
# These vars are REQUIRED — compose aborts if any are unset.
# Defaults keep the legacy `ironpulse` DB name so existing installs
# and backups continue to work after the Zor rebrand.
POSTGRES_USER=ironpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ironpulse

# ── MinIO — S3-compatible object storage (REQUIRED) ───────────
# Used by: minio service, minio-init bucket setup script,
# and the app (S3_ACCESS_KEY / S3_SECRET_KEY).
# These vars are REQUIRED — compose aborts if any are unset.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# ── PowerSync (offline mobile/web sync) ───────────────────────
# RSA keypair for signing sync tokens. Auto-generated if left blank.
POWERSYNC_PRIVATE_KEY=
POWERSYNC_PUBLIC_KEY=

# ── Optional: AI workout generation ───────────────────────────
# Self-hosters supply their own OpenAI key; usage is billed to that key.
# Leave blank to disable the AI-workout feature.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Optional: OAuth sign-in providers ─────────────────────────
# Register an OAuth app with each provider and set the redirect URL to
# <NEXTAUTH_URL>/api/auth/callback/<provider>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# ── Optional: transactional email (password reset, etc.) ──────
RESEND_API_KEY=
EMAIL_FROM=Zor <noreply@zor.app>

# ── Optional: Stripe (coach subscriptions) ────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COACH_MONTHLY=
STRIPE_PRICE_COACH_YEARLY=

# ── Optional: meal photo scanning (Clarifai vision API) ───────
MEAL_SCAN_API_KEY=

# ── Optional: fitness device integrations ─────────────────────
# DEVICE_TOKEN_ENCRYPTION_KEY encrypts stored device OAuth tokens at rest.
# Generate with: openssl rand -hex 32
DEVICE_TOKEN_ENCRYPTION_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
