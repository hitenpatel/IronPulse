# ─────────────────────────────────────────────────────────────
# Mettle Lift — PRODUCTION host configuration.
# Copy to `.env` on the production host and fill in real values.
#   cp .env.prod.example .env
# Variables marked REQUIRED must be set — docker compose will fail
# fast with a clear error if any are missing.
# ─────────────────────────────────────────────────────────────

# Written by remote-deploy.sh after migration succeeds — do not set manually.
IMAGE_TAG=

# REQUIRED — session signing secret. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Host ports ────────────────────────────────────────────────
# Published host ports; accept an optional bind address prefix.
# Traefik reaches the app over the docker network, so loopback binds
# keep these off the public interface.
APP_PORT=127.0.0.1:3010
POWERSYNC_PORT=127.0.0.1:8581
MINIO_CONSOLE_PORT=127.0.0.1:9101

# ── Database (REQUIRED) ───────────────────────────────────────
# Pre-SDLC production data lives under the `ironpulse` role/database —
# keep these values so the existing pgdata volume keeps working.
POSTGRES_USER=ironpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ironpulse

# ── MinIO — S3-compatible object storage (REQUIRED) ───────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
# Pre-SDLC bucket name; production objects live in `ironpulse`.
S3_BUCKET=ironpulse

# ── PowerSync (offline mobile/web sync) ───────────────────────
POWERSYNC_PRIVATE_KEY=
POWERSYNC_PUBLIC_KEY=

# ── Profiles ──────────────────────────────────────────────────
# Enable nightly pg_dump backup (strongly recommended for production).
COMPOSE_PROFILES=backup

# ── Optional: AI workout generation ───────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Optional: OAuth sign-in providers ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# ── Optional: transactional email ─────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Mettle Lift <noreply@mettlelift.app>

# ── Optional: Stripe ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COACH_MONTHLY=
STRIPE_PRICE_COACH_YEARLY=

# ── Optional: meal photo scanning ─────────────────────────────
MEAL_SCAN_API_KEY=

# ── Optional: fitness device integrations ─────────────────────
DEVICE_TOKEN_ENCRYPTION_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
