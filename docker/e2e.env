# Env overlay for the isolated Maestro E2E stack (project `zor-e2e`).
#
# Layered on top of docker/.env:
#   docker compose --env-file .env --env-file e2e.env \
#     -f docker-compose.yml -f docker-compose.e2e.yml --profile sync up -d
#
# Every value here is DISPOSABLE and applies only to the throwaway E2E project,
# whose volumes (zor-e2e_pgdata etc.) are separate from the dev stack's. It
# deliberately overrides NEXTAUTH_SECRET so a test run can never mint tokens
# valid against the dev or production database.
#
# The stack binds only to this host's interfaces and must never be exposed
# publicly. Nothing here is a real credential.

NEXTAUTH_SECRET=zor-e2e-disposable-nextauth-secret-do-not-reuse

POSTGRES_USER=zor_e2e
POSTGRES_PASSWORD=zor_e2e
POSTGRES_DB=zor_e2e

MINIO_ROOT_USER=zor-e2e
MINIO_ROOT_PASSWORD=zor-e2e-disposable
S3_BUCKET=zor-e2e
